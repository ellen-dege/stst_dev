# Google Sheets Integration (optional)
# See README.md "Google Sheets Integration" section for setup instructions

# Option A: Service account JSON as environment variable (preferred for CI/containers)
# Paste the entire JSON contents of your service account key file
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# Option B: Path to service account JSON file (for local development)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account-credentials.json

# Google Sheet ID (from the sheet URL)
# URL format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
STST_ATTENDANCE_SHEET_ID=your-sheet-id-here
